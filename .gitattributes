# 文本统一按 LF 入库、按 LF 检出（Node 包跨平台一致）
* text=auto eol=lf

# Windows 脚本保持 CRLF，避免 cmd.exe 解析问题
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制（README 截图、抓图产物）
*.png binary
*.jpg binary
*.gif binary
*.bmp binary
*.ico binary

# 生成物：折叠 diff、不计语言统计
lib/client.js.map -diff linguist-generated
pnpm-lock.yaml -diff linguist-generated
